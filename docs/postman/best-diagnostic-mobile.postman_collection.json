{
  "info": {
    "name": "BEST Diagnostic Mobile API",
    "description": "Endpoints used by the mobile app. Run 'Staff / Login' first; it stores the token in the collection variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://admin.bestdiagnostic.com.bd/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pdfUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Patient (no login)",
      "item": [
        {
          "name": "Search report by passport",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/certificate/search?passport_no=A04539821",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "certificate",
                "search"
              ],
              "query": [
                {
                  "key": "passport_no",
                  "value": "A04539821"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.pdf_url) { pm.collectionVariables.set('pdfUrl', json.pdf_url); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Search report by passport + token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/certificate/search?passport_no=A04539821&token=BEST000752",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "certificate",
                "search"
              ],
              "query": [
                {
                  "key": "passport_no",
                  "value": "A04539821"
                },
                {
                  "key": "token",
                  "value": "BEST000752"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.pdf_url) { pm.collectionVariables.set('pdfUrl', json.pdf_url); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Download certificate PDF (uses pdfUrl from last search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pdfUrl}}"
            }
          }
        },
        {
          "name": "Request callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/callback-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "callback-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Md Rahman\",\n  \"mobile\": \"01712345678\",\n  \"reason\": \"Online Report Status\"\n}"
            }
          }
        },
        {
          "name": "Site settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/site-settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "site-settings"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Staff",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) { pm.collectionVariables.set('token', json.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) { pm.collectionVariables.set('token', json.access_token); }"
                ]
              }
            }
          ]
        },
